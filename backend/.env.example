# Postgres (users, chats, messages, document chunks + embeddings)
# Option A: one connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/docmind

# Option B: separate fields (used if DATABASE_URL is empty)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=docmind

# OpenRouter (chat + embeddings)
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=DocMind

# Auth
JWT_SECRET=change-this-to-a-long-random-string
